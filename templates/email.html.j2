{#- The AI Brew daily email. Inline styles and tables only: email apps strip <style> and JS.
    Colours match the web edition (site_static/style.css): ceramic white + cobalt glaze. -#}
{%- set page = "#EEF0F4" -%}
{%- set card = "#FFFFFF" -%}
{%- set ink = "#0E1116" -%}
{%- set soft = "#343A44" -%}
{%- set faint = "#5F6672" -%}
{%- set rule = "#CDD2DB" -%}
{%- set cobalt = "#1B3FD1" -%}
{%- set wash = "#DCE4FF" -%}
{%- set latte = "#B0581A" -%}
{%- set night = "#0F1A3D" -%}
{%- set night_text = "#E9ECF1" -%}
{%- set night_soft = "#A7AFBC" -%}
{%- set serif = "Georgia,'Times New Roman',serif" -%}
{%- set mono = "Menlo,Consolas,'Courier New',monospace" -%}

{%- macro read_more(story, label="Read more", color=cobalt) -%}
<div style="margin-top:8px;font-size:13px;"><a href="{{ story.link }}" style="color:{{ color }};font-weight:600;text-decoration:none;">{{ label }} &rarr;</a> <span style="font-family:{{ mono }};font-size:11px;color:{{ faint if color == cobalt else night_soft }};">&nbsp;{{ story.source }}</span></div>
{%- endmacro -%}

{#- Every section opens with its plain name and one line saying what it is. -#}
{%- macro section_title(name, note, dark=false) -%}
<div style="font-family:{{ mono }};font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:{{ '#7D9BFF' if dark else cobalt }};">{{ name }}</div>
<div style="font-size:14px;color:{{ night_soft if dark else faint }};margin-top:2px;">{{ note }}</div>
{%- endmacro -%}

<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>The AI Brew — {{ issue.date_long }}</title>
</head>
<body style="margin:0;padding:0;background:{{ page }};">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:{{ page }};">
<tr><td align="center" style="padding:24px 10px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:100%;max-width:600px;background:{{ card }};border:1px solid {{ rule }};border-radius:10px;font-family:-apple-system,'Segoe UI',Roboto,Arial,sans-serif;font-size:16px;line-height:1.6;color:{{ ink }};">

  {#- Masthead #}
  <tr><td style="padding:32px 32px 0;text-align:center;">
    <div style="font-family:{{ serif }};font-size:46px;line-height:1.1;">The AI <i style="color:{{ cobalt }};">Brew</i></div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:16px;border-top:2px solid {{ ink }};border-bottom:1px solid {{ rule }};font-family:{{ mono }};font-size:11px;letter-spacing:1px;text-transform:uppercase;color:{{ faint }};">
      <tr><td style="padding:8px 0;" align="left">No. {{ issue.number }}</td><td align="center">{{ issue.date_long }}</td><td align="right">{{ issue.read_minutes }} min read</td></tr>
    </table>
    <p style="margin:16px 0 0;font-size:16px;color:{{ soft }};">The day's AI news in five minutes: what happened, how companies are using it, and what's coming next.</p>
    {%- if issue.web_url %}
    <div style="margin-top:8px;font-size:13px;"><a href="{{ issue.web_url }}" style="color:{{ cobalt }};">Read it on the web</a></div>
    {%- endif %}
  </td></tr>

  {#- In today's issue: every section with its first headline #}
  {%- if issue.menu %}
  <tr><td style="padding:24px 32px 0;">
    <div style="background:{{ page }};border-radius:8px;padding:16px 20px 8px;">
      <div style="font-family:{{ mono }};font-size:11px;letter-spacing:2px;text-transform:uppercase;color:{{ faint }};">In today's issue</div>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:6px;font-size:14px;line-height:1.4;">
        {%- for name, line in issue.menu %}
        <tr><td valign="top" width="130" style="padding:8px 10px 8px 0;font-weight:700;color:{{ cobalt }};{{ '' if loop.first else 'border-top:1px dashed ' ~ rule ~ ';' }}">{{ name }}</td>
          <td valign="top" style="padding:8px 0;{{ '' if loop.first else 'border-top:1px dashed ' ~ rule ~ ';' }}">{{ line }}</td></tr>
        {%- endfor %}
      </table>
    </div>
  </td></tr>
  {%- endif %}

  {#- Top Stories: one lead story + up to two side-by-side #}
  {%- if issue.big_pour %}
  {%- set lead = issue.big_pour[0] %}
  <tr><td style="padding:34px 32px 0;">
    {{ section_title("Top Stories", "The biggest AI news of the day") }}
    <div style="font-family:{{ serif }};font-size:28px;line-height:1.2;margin-top:14px;">{{ lead.headline }}</div>
    <p style="margin:10px 0 0;">{{ lead.summary }}</p>
    {%- if lead.why %}
    <div style="background:{{ wash }};border-left:3px solid {{ cobalt }};padding:10px 14px;margin-top:14px;font-size:15px;color:{{ soft }};"><b style="color:{{ ink }};">Why you should care:</b> {{ lead.why }}</div>
    {%- endif %}
    {{ read_more(lead, "Read the full story") }}

    {%- if issue.big_pour | length > 1 %}
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:24px;border-top:1px solid {{ rule }};">
      <tr>
        {%- for story in issue.big_pour[1:3] %}
        <td valign="top" width="50%" style="padding:16px {{ '14px 0 0' if loop.first else '0 0 14px' }};{{ '' if loop.first else 'border-left:1px solid ' ~ rule ~ ';' }}">
          <div style="font-family:{{ serif }};font-size:19px;line-height:1.25;">{{ story.headline }}</div>
          <p style="margin:6px 0 0;font-size:15px;color:{{ soft }};">{{ story.summary }}</p>
          {{ read_more(story) }}
        </td>
        {%- endfor %}
      </tr>
    </table>
    {%- endif %}
  </td></tr>
  {%- endif %}

  {#- AI at Work #}
  {%- if issue.office_blend %}
  <tr><td style="padding:34px 32px 0;">
    {{ section_title("AI at Work", "How real companies are using AI at work") }}
    {%- for story in issue.office_blend %}
    <div style="border:1px solid {{ rule }};border-radius:8px;padding:16px 18px;margin-top:14px;">
      <div style="font-family:{{ serif }};font-size:20px;line-height:1.25;">{{ story.headline }}</div>
      <p style="margin:6px 0 0;font-size:15px;color:{{ soft }};">{{ story.summary }}</p>
      {{ read_more(story) }}
    </div>
    {%- endfor %}
  </td></tr>
  {%- endif %}

  {#- Coming Up: date shown only if the source stated one #}
  {%- if issue.still_roasting %}
  <tr><td style="padding:34px 32px 0;">
    {{ section_title("Coming Up", "Launches and events worth watching") }}
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:10px;font-size:15px;">
      {%- for item in issue.still_roasting %}
      <tr><td valign="top" width="34" style="padding:10px 0;font-family:{{ mono }};font-size:13px;font-weight:700;color:{{ cobalt }};{{ '' if loop.first else 'border-top:1px solid ' ~ rule ~ ';' }}">{{ "%02d" | format(loop.index) }}</td>
        <td style="padding:10px 0;{{ '' if loop.first else 'border-top:1px solid ' ~ rule ~ ';' }}">{{ item.summary }}
          <div style="font-family:{{ mono }};font-size:11px;color:{{ faint }};margin-top:4px;">{{ item.date_mentioned or "Date not announced" }} &middot; <a href="{{ item.link }}" style="color:{{ cobalt }};">{{ item.get("source") or "Source" }}</a></div></td></tr>
      {%- endfor %}
    </table>
  </td></tr>
  {%- endif %}

  {#- In Brief #}
  {%- if issue.quick_sips %}
  <tr><td style="padding:34px 32px 0;">
    {{ section_title("In Brief", "More AI news, one line each") }}
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:10px;font-size:15px;">
      {%- for sip in issue.quick_sips %}
      <tr><td valign="top" width="20" style="padding:8px 0;color:{{ latte }};">&bull;</td>
        <td style="padding:8px 0;">{{ sip.summary }} <a href="{{ sip.link }}" style="font-family:{{ mono }};font-size:11px;color:{{ cobalt }};">{{ sip.source }}</a></td></tr>
      {%- endfor %}
    </table>
  </td></tr>
  {%- endif %}

  {#- For Engineers: the one dark card #}
  {%- if issue.builder %}
  <tr><td style="padding:34px 32px 0;">
    <div style="background:{{ night }};color:{{ night_text }};border-radius:8px;padding:22px 22px 20px;">
      {{ section_title("For Engineers", "New tools, models and ideas for people who build with AI", dark=true) }}
      {%- for story in issue.builder.stories %}
      <div style="border-top:1px solid #2A3866;margin-top:16px;padding-top:14px;">
        <div style="font-family:{{ mono }};font-size:10px;letter-spacing:2px;text-transform:uppercase;color:{{ night_soft }};">{{ story.label }}</div>
        <div style="font-family:{{ serif }};font-size:19px;margin-top:4px;">{{ story.headline }}</div>
        <p style="margin:6px 0 0;font-size:15px;color:{{ night_soft }};">{{ story.summary }}</p>
        {{ read_more(story, color="#7D9BFF") }}
      </div>
      {%- endfor %}
      {%- if issue.builder.concept %}
      {%- set c = issue.builder.concept %}
      <div style="border:1px solid #7D9BFF;border-radius:6px;padding:12px 14px;margin-top:18px;">
        <div style="font-family:{{ mono }};font-size:10px;letter-spacing:2px;text-transform:uppercase;color:#7D9BFF;">Concept to know</div>
        <div style="font-family:{{ serif }};font-size:18px;margin-top:4px;">{{ c.term }}</div>
        <p style="margin:4px 0 0;font-size:14px;color:{{ night_soft }};">{{ c.explanation }}{% if c.link %} <a href="{{ c.link }}" style="color:#7D9BFF;">Source</a>{% endif %}</p>
      </div>
      {%- endif %}
    </div>
  </td></tr>
  {%- endif %}

  {#- Long Read: an opinion piece, so the author is named #}
  {%- if issue.long_read %}
  {%- set lr = issue.long_read %}
  <tr><td style="padding:34px 32px 0;">
    {{ section_title("The Long Read", "One essay worth your time this week") }}
    <div style="border-left:3px solid {{ latte }};padding:2px 0 2px 16px;margin-top:14px;">
      <div style="font-family:{{ serif }};font-size:21px;line-height:1.3;">{{ lr.headline }}</div>
      <div style="font-family:{{ mono }};font-size:11px;text-transform:uppercase;color:{{ faint }};margin-top:4px;">from {{ lr.source }}</div>
      <p style="margin:8px 0 0;font-size:15px;color:{{ soft }};">{{ lr.summary }}</p>
      {{ read_more(lr, "Read the essay") }}
    </div>
  </td></tr>
  {%- endif %}

  {#- Word of the Day + Keep Learning #}
  {%- if issue.word or issue.keep_brewing %}
  <tr><td style="padding:34px 32px 0;">
    {{ section_title("Learn", "One AI term explained, and one way to keep learning") }}
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:14px;">
      <tr>
        {%- if issue.word %}
        {%- set w = issue.word %}
        <td valign="top" width="50%" style="background:{{ wash }};border-radius:8px;padding:18px 16px;">
          <div style="font-family:{{ mono }};font-size:10px;letter-spacing:2px;text-transform:uppercase;color:{{ cobalt }};">Word of the Day</div>
          <div style="font-family:{{ serif }};font-size:26px;margin-top:6px;">{{ w.term }}</div>
          <div style="font-size:12px;color:{{ faint }};">{{ w.theme }}, {{ w.day }} of 5</div>
          {%- if w.heard is defined and w.heard %}<p style="margin:10px 0 0;font-size:13px;font-style:italic;color:{{ soft }};">{{ w.heard }}</p>{% endif %}
          <p style="margin:8px 0 0;font-size:14px;">{{ w.definition }}</p>
          <p style="margin:8px 0 0;font-size:14px;font-style:italic;color:{{ soft }};">{{ w.analogy }}</p>
        </td>
        {%- endif %}
        {%- if issue.word and issue.keep_brewing %}<td width="12"></td>{% endif %}
        {%- if issue.keep_brewing %}
        {%- set kb = issue.keep_brewing %}
        <td valign="top" width="50%" style="border:1px solid {{ rule }};border-radius:8px;padding:18px 16px;">
          <div style="font-family:{{ mono }};font-size:10px;letter-spacing:2px;text-transform:uppercase;color:{{ cobalt }};">Keep Learning</div>
          <div style="font-family:{{ serif }};font-size:20px;margin-top:6px;">{{ kb.name }}</div>
          <p style="margin:8px 0 0;font-size:14px;">{{ kb.description }}</p>
          <div style="margin-top:8px;font-size:13px;"><a href="{{ kb.link }}" style="color:{{ cobalt }};font-weight:600;text-decoration:none;">Start here &rarr;</a></div>
        </td>
        {%- endif %}
      </tr>
    </table>
  </td></tr>
  {%- endif %}

  {#- Quick Poll: buttons open a reply that is already filled in #}
  {%- if issue.poll %}
  {%- set p = issue.poll %}
  <tr><td style="padding:34px 32px 0;">
    {{ section_title("Quick Poll", "Tap to vote; results in the next issue") }}
    {%- if p.last_results %}
    <div style="font-size:14px;color:{{ soft }};margin-top:10px;">Last time: {{ p.last_results }}</div>
    {%- endif %}
    <div style="font-family:{{ serif }};font-size:21px;margin-top:10px;">{{ p.question }}</div>
    <div style="margin-top:12px;">
      {%- for answer in ["YES", "NO"] %}
      <a href="mailto:{{ issue.reply_to }}?subject={{ ('Poll ' ~ issue.date_iso ~ ': ' ~ answer) | urlencode }}" style="display:inline-block;background:{{ cobalt if loop.first else card }};border:1px solid {{ cobalt }};border-radius:6px;padding:8px 26px;font-size:13px;font-weight:700;letter-spacing:1px;margin:0 6px 0 0;color:{{ card if loop.first else cobalt }};text-decoration:none;">{{ answer }}</a>
      {%- endfor %}
    </div>
  </td></tr>
  {%- endif %}

  {#- Feedback: replies go to the sender's inbox, so no address is printed #}
  <tr><td style="padding:30px 32px 0;">
    <div style="background:{{ page }};border-radius:8px;padding:16px 20px;">
      <div style="font-family:{{ mono }};font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:{{ cobalt }};">Tell me what you think</div>
      <p style="margin:6px 0 0;font-size:15px;color:{{ soft }};">Something confusing, missing, or great? Just hit reply. I read every message and use it to make the next issue better.</p>
    </div>
  </td></tr>

  {#- Sign-off + footer #}
  <tr><td style="padding:32px 32px 30px;">
    <div style="border-top:1px solid {{ rule }};padding-top:18px;font-size:16px;font-style:italic;color:{{ soft }};">{{ issue.sign_off }}</div>
    <p style="margin:14px 0 0;font-size:12px;color:{{ faint }};line-height:1.6;">Built by Shreya Deshpande. Every story links to its source.<br>Forwarded to you? <a href="{{ issue.subscribe_url }}" style="color:{{ cobalt }};">Subscribe</a> &middot; <a href="{{ issue.unsubscribe_url }}" style="color:{{ faint }};">Unsubscribe</a></p>
  </td></tr>

</table>
</td></tr>
</table>
</body>
</html>
