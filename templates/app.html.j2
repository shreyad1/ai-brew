<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>The AI Brew</title>
<meta name="description" content="A 3-minute AI briefing every morning, with every fact checked against its source. Built by Shreya Deshpande.">
<meta name="theme-color" content="#1B3FD1">

<!-- Link previews (iMessage, WhatsApp, Slack, LinkedIn, X) -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="The AI Brew">
<meta property="og:title" content="The AI Brew">
<meta property="og:description" content="A 3-minute AI briefing every morning, with every fact checked against its source. Built by Shreya Deshpande.">
<meta property="og:url" content="https://theaibrew.pages.dev/">
<meta property="og:image" content="https://theaibrew.pages.dev/og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="The AI Brew by Shreya Deshpande: a 3-minute AI briefing, every morning.">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="https://theaibrew.pages.dev/og-image.png">

<!-- Icons for browser tabs and phone home screens -->
<link rel="icon" type="image/png" sizes="32x32" href="favicon-32.png">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<meta name="apple-mobile-web-app-title" content="AI Brew">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Gloock&family=Hanken+Grotesk:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
<script>
  // Apply the saved theme before the page paints, so it never flashes the wrong colours.
  try { const t = localStorage.getItem("aibrew-theme"); if (t) document.documentElement.dataset.theme = t; } catch {}
</script>
</head>
<body>
<div class="shell">

  <header class="appbar">
    <div class="brand-group">
      <a class="brand" href="#/today">The AI <em>Brew</em></a>
      <a class="byline" href="https://github.com/shreyad1" target="_blank" rel="noopener">by Shreya Deshpande</a>
    </div>
    <div class="controls">
      <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to dark theme"><span class="sun" aria-hidden="true">&#9728;</span><span class="moon" aria-hidden="true">&#9790;</span></button>
    </div>
  </header>

  <nav class="tabs" aria-label="Sections">
    <a href="#/today" data-tab="today"><span class="ico" aria-hidden="true">&#9749;</span>Today</a>
    <a href="#/events" data-tab="events"><span class="ico" aria-hidden="true">&#9673;</span>Events</a>
    <a href="#/archive" data-tab="archive"><span class="ico" aria-hidden="true">&#8981;</span>Archive</a>
    <a href="#/saved" data-tab="saved"><span class="ico" aria-hidden="true">&#9734;</span>Saved <span class="badge" id="saved-count" hidden></span></a>
  </nav>

  <main id="view" class="view" tabindex="-1" aria-live="polite">
    <p class="loading">Pouring today's issue&hellip;</p>
  </main>

  <template id="places-template">
    <select id="place-picker">
      <option value="">Choose your state or city</option>
      <optgroup label="United States">
        {%- for code, name in places.us %}<option value="{{ code }}">{{ name }}</option>{% endfor %}
      </optgroup>
      <optgroup label="India">
        {%- for name in places.india %}<option value="{{ name }}">{{ name }}</option>{% endfor %}
      </optgroup>
    </select>
  </template>
</div>

<script type="application/json" id="app-data">{{ data_json | safe }}</script>
<script src="illustrations.js"></script>
<script src="app.js"></script>
</body>
</html>
