{#- The AI Brew web edition. Unlike the email, a web page can use real CSS and JavaScript. -#}
{%- macro rail(name, plain, key) -%}
<div class="rail"><h2>{{ name }}</h2></div>
{%- endmacro -%}
{%- macro figure(story) -%}
{%- if story.image %}
<figure class="photo"><a href="{{ story.link }}" tabindex="-1"><img src="{{ story.image }}" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.closest('figure').remove()"></a><figcaption>Image: {{ story.source }}</figcaption></figure>
{%- endif %}
{%- endmacro -%}
{%- macro meta(story) -%}
<div class="meta"><a href="{{ story.link }}">Read at {{ story.source }} &rarr;</a></div>
{%- endmacro -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>The AI Brew No. {{ issue.number }}</title>
<meta name="description" content="{{ issue.big_pour[0].headline if issue.big_pour else 'A 3-minute AI briefing every weekday morning.' }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Gloock&family=Hanken+Grotesk:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ root }}style.css">
</head>
<body data-audience="everyone">
<div class="wrap">

  <nav class="bar">
    <a href="{{ root }}index.html">&larr; All issues</a>
    <div class="audience" role="group" aria-label="Show stories for">
      <button type="button" data-audience="everyone" aria-pressed="true">Everyone</button>
      <button type="button" data-audience="engineers" aria-pressed="false">Engineers</button>
    </div>
  </nav>

  <header>
    <div class="masthead">
      <h1 class="wordmark">The AI <em>Brew</em></h1>
      <div class="stamp"><b>No. {{ "%03d" | format(issue.number) }}</b>{{ issue.date_long }}<br>total brew time {{ times.total }}</div>
    </div>
    <nav class="ticket" aria-label="In this issue">
      {%- for name, teaser in issue.menu %}
      <a href="#{{ name | lower | replace(' ', '-') | replace("'", '') }}"{% if name == "The Builder's Bar" %} class="eng-only"{% endif %}><b>{{ name }}</b><span>{{ teaser }}</span></a>
      {%- endfor %}
    </nav>
  </header>

  {%- if issue.big_pour %}
  {%- set lead = issue.big_pour[0] %}
  <section class="section" id="the-big-pour">
    {{ rail("The Big Pour", "Today's biggest AI news.", "big_pour") }}
    <div class="content">
      <article class="story lead">
        {{ figure(lead) }}
        <h3>{{ lead.headline }}</h3>
        <p>{{ lead.summary }}</p>
        {%- if lead.why %}<div class="why"><b>Why you should care</b>{{ lead.why }}</div>{% endif %}
        {{ meta(lead) }}
      </article>
      {%- if issue.big_pour | length > 1 %}
      <div class="pair-stories">
        {%- set pair = issue.big_pour[1:3] %}
        {%- set pair_has_images = pair | selectattr("image") | list | length == pair | length %}
        {%- for story in pair %}
        <article class="story">
          {%- if pair_has_images %}{{ figure(story) }}{% endif %}
          <h3>{{ story.headline }}</h3>
          <p>{{ story.summary }}</p>
          {{ meta(story) }}
        </article>
        {%- endfor %}
      </div>
      {%- endif %}
    </div>
  </section>
  {%- endif %}

  {%- if issue.builder and (issue.builder.stories or issue.builder.concept) %}
  <section class="section night eng-only" id="the-builders-bar">
    {{ rail("The Builder's Bar", "New AI tools and ideas for engineers.", "builder") }}
    <div class="content">
      {%- for story in issue.builder.stories %}
      <article class="story">
        {{ figure(story) }}
        <span class="label">{{ story.label }}</span>
        <h3>{{ story.headline }}</h3>
        <p>{{ story.summary }}</p>
        {{ meta(story) }}
      </article>
      {%- endfor %}
      {%- if issue.builder.concept %}
      {%- set c = issue.builder.concept %}
      <div class="card" data-open="false">
        <span class="label">Concept to know</span>
        <span class="term">{{ c.term }}</span>
        <button type="button" class="reveal" aria-expanded="false">What does it mean?</button>
        <div class="hidden-part"><p class="def">{{ c.explanation }}</p></div>
      </div>
      {%- endif %}
    </div>
  </section>
  {%- endif %}

  {%- if issue.office_blend %}
  <section class="section" id="office-blend">
    {{ rail("Office Blend", "How real companies use AI at work.", "office_blend") }}
    <div class="content">
      {%- for story in issue.office_blend %}
      <article class="story">
        {{ figure(story) }}
        <h3>{{ story.headline }}</h3>
        <p>{{ story.summary }}</p>
        {{ meta(story) }}
      </article>
      {%- endfor %}
    </div>
  </section>
  {%- endif %}

  {%- if issue.still_roasting %}
  <section class="section" id="still-roasting">
    {{ rail("Still Roasting", "Coming soon. Worth watching.", "still_roasting") }}
    <div class="content">
      <ul class="list">
        {%- for item in issue.still_roasting %}
        <li><span class="n">{{ "%02d" | format(loop.index) }}</span><div><p>{{ item.summary }}</p><span class="when">{{ item.date_mentioned or "Date not announced" }} &middot; <a href="{{ item.link }}">{{ item.source }}</a></span></div></li>
        {%- endfor %}
      </ul>
    </div>
  </section>
  {%- endif %}

  {%- if issue.quick_sips %}
  <section class="section" id="quick-sips">
    {{ rail("Quick Sips", "More AI news, one line each.", "quick_sips") }}
    <div class="content">
      <ul class="list">
        {%- for sip in issue.quick_sips %}
        <li><span class="n">&mdash;</span><div><p>{{ sip.summary }}</p><span class="when"><a href="{{ sip.link }}">{{ sip.source }}</a></span></div></li>
        {%- endfor %}
      </ul>
    </div>
  </section>
  {%- endif %}

  {%- if issue.long_read %}
  {%- set lr = issue.long_read %}
  <section class="section" id="the-long-read">
    {{ rail("The Long Read", "One essay for your second cup.", "long_read") }}
    <div class="content">
      <article class="story">
        <span class="label">from {{ lr.source }}</span>
        <h3>{{ lr.headline }}</h3>
        <p>{{ lr.summary }}</p>
        {{ meta(lr) }}
      </article>
    </div>
  </section>
  {%- endif %}

  {%- if issue.word or issue.keep_brewing %}
  <section class="section" id="word-of-the-day">
    {{ rail("Learn", "", "learn") }}
    <div class="content">
      <div class="cards">
        {%- if issue.word %}
        {%- set w = issue.word %}
        <div class="card" data-open="false">
          <span class="label">Word of the day &middot; {{ w.theme }}, {{ w.day }} of 5</span>
          <span class="term">{{ w.term }}</span>
          <button type="button" class="reveal" aria-expanded="false">Reveal the meaning</button>
          <div class="hidden-part"><p>{{ w.definition }}</p><p class="def">{{ w.analogy }}</p></div>
        </div>
        {%- endif %}
        {%- if issue.keep_brewing %}
        {%- set kb = issue.keep_brewing %}
        <div class="card">
          <span class="label">Keep brewing</span>
          <span class="term" style="font-size: var(--step-2)">{{ kb.name }}</span>
          <p class="def">{{ kb.description }}</p>
          <a href="{{ kb.link }}">Start here &rarr;</a>
        </div>
        {%- endif %}
      </div>
    </div>
  </section>
  {%- endif %}

  {%- if issue.poll %}
  <section class="section" id="poll">
    {{ rail("Tip Jar Poll", "Reply with one word. Results next issue.", "poll") }}
    <div class="content">
      {%- if issue.poll.last_results %}<p class="mono">Last time: {{ issue.poll.last_results }}</p>{% endif %}
      <p class="question">{{ issue.poll.question }}</p>
      <div class="vote">
        {%- for answer in ["YES", "NO"] %}
        <a href="mailto:{{ issue.reply_to }}?subject={{ ('Poll ' ~ issue.date_iso ~ ': ' ~ answer) | urlencode }}">{{ answer }}</a>
        {%- endfor %}
      </div>
    </div>
  </section>
  {%- endif %}

  <section class="section" id="subscribe">
    <div class="rail"><h2>Get your own cup</h2></div>
    <div class="content">
      <form class="signup" action="https://buttondown.com/api/emails/embed-subscribe/aibrew" method="post" target="_blank">
        <label for="email" class="visually-hidden">Email address</label>
        <input id="email" type="email" name="email" placeholder="you@example.com" required>
        <button type="submit">Subscribe</button>
      </form>
    </div>
  </section>

  <footer>
    <span>{{ issue.sign_off }}</span>
    <span>Written by an AI agent, checked against its sources. <a href="https://github.com/shreyad1/ai-brew">How it's made</a></span>
  </footer>
</div>
<script src="{{ root }}app.js"></script>
</body>
</html>
