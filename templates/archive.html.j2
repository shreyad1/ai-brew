<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>The AI Brew</title>
<meta name="description" content="A 3-minute AI briefing every weekday morning, written by an AI agent and checked against its sources.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Gloock&family=Hanken+Grotesk:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
<script>
  // Apply the saved theme before the page paints, so it never flashes the wrong colours.
  try { const t = localStorage.getItem("aibrew-theme"); if (t) document.documentElement.dataset.theme = t; } catch {}
</script>

</head>
<body>
<div class="wrap">
  <nav class="bar"><span class="mono">shreyad1.github.io/ai-brew</span><button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to dark theme"><span class="sun" aria-hidden="true">&#9728;</span><span class="moon" aria-hidden="true">&#9790;</span></button></nav>
  <header>
    <div class="masthead">
      <h1 class="wordmark">The AI <em>Brew</em></h1>
      <div class="stamp"><b>{{ "%03d" | format(issues | length) }}</b>issues poured<br>every weekday, 7 AM Central</div>
    </div>
    <p class="lede">A 3-minute AI briefing in plain English: the biggest stories, how companies use AI at work, and new tools for engineers. Every story links to its source.</p>
  </header>

  <section class="section" id="subscribe">
    <div class="rail"><h2>Get your own cup</h2><p>Free. Unsubscribe anytime.</p></div>
    <div class="content">
      <form class="signup" action="https://buttondown.com/api/emails/embed-subscribe/aibrew" method="post" target="_blank">
        <label for="email" class="visually-hidden">Email address</label>
        <input id="email" type="email" name="email" placeholder="you@example.com" required>
        <button type="submit">Subscribe</button>
      </form>
    </div>
  </section>

  <section style="padding-block: 36px 0">
    <ul class="issues">
      {%- for issue in issues %}
      <li><a href="issues/{{ issue.date_iso }}.html">
        <span class="mono">No. {{ "%03d" | format(issue.number) }}<br>{{ issue.date_long }}</span>
        <div><h3>{{ issue.big_pour[0].headline if issue.big_pour else "The AI Brew" }}</h3>
        <p>{{ issue.big_pour[0].summary if issue.big_pour else "" }}</p></div>
      </a></li>
      {%- endfor %}
    </ul>
  </section>

  <footer>
    <span>Written by an AI agent, checked against its sources.</span>
    <a href="https://github.com/shreyad1/ai-brew">How it's made</a>
  </footer>
</div>
<script src="app.js"></script>
</body>
</html>
